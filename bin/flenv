#!/usr/bin/env bash
set -Eeuo pipefail

FLENV_VERSION="0.1.0-dev"
FLENV_BIN_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
FLENV_ROOT_DIR="$(cd -P -- "$FLENV_BIN_DIR/.." && pwd)"

# shellcheck source=../lib/core.sh
source "$FLENV_ROOT_DIR/lib/core.sh"
# shellcheck source=../lib/provision.sh
source "$FLENV_ROOT_DIR/lib/provision.sh"
# shellcheck source=../lib/flutter.sh
source "$FLENV_ROOT_DIR/lib/flutter.sh"
# shellcheck source=../lib/java.sh
source "$FLENV_ROOT_DIR/lib/java.sh"
# shellcheck source=../lib/android.sh
source "$FLENV_ROOT_DIR/lib/android.sh"
# shellcheck source=../lib/commands/install.sh
source "$FLENV_ROOT_DIR/lib/commands/install.sh"
# shellcheck source=../lib/commands/list.sh
source "$FLENV_ROOT_DIR/lib/commands/list.sh"
# shellcheck source=../lib/commands/doctor.sh
source "$FLENV_ROOT_DIR/lib/commands/doctor.sh"
# shellcheck source=../lib/commands/env.sh
source "$FLENV_ROOT_DIR/lib/commands/env.sh"

flenv_help() {
	cat <<'EOF'
flenv - lightweight Flutter environment manager

Usage:
  flenv install [--root DIR] [--name NAME] [--isolated]
  flenv list
  flenv use <name>
  flenv env <name>
  flenv doctor [--name NAME] [-v|--verbose]
  flenv --help
  flenv --version

Commands:
  install   Create and provision a Flutter + Android environment
  list      List known environments
  use       Select the default environment
  env       Print shell activation exports
  doctor    Diagnose a managed Flutter environment

Options:
  --root DIR    Store the environment below DIR/flenv/environments
  --name NAME   Environment name (default: default)
  --isolated    Keep caches and workspace inside the environment
  -h, --help    Show help
  -v, --version Show version

Doctor options:
  --name NAME   Diagnose a named environment (default: default)
  -v, --verbose Show resolved paths and readiness state
EOF
}

main() {
	local command="${1:-}"

	case "$command" in
	install)
		shift
		flenv_install "$@"
		;;
	list)
		shift
		(($# == 0)) || flenv_die "list does not accept arguments"
		flenv_list
		;;
	use)
		shift
		flenv_use "$@"
		;;
	env)
		shift
		flenv_env "$@"
		;;
	doctor)
		shift
		flenv_doctor "$@"
		;;
	-h | --help | help | "")
		flenv_help
		;;
	-v | --version | version)
		printf 'flenv %s\n' "$FLENV_VERSION"
		;;
	*)
		flenv_die "unknown command: $command"
		;;
	esac
}

main "$@"
